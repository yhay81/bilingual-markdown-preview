{
  "name": "bilingual-markdown-preview",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "private": true,
  "publisher": "yhay81",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/yhay81/bilingual-markdown-preview.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "translation",
    "bilingual",
    "japanese",
    "claude",
    "openai",
    "byok"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onWebviewPanel:bilingualMarkdown.preview"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces%",
      "restrictedConfigurations": [
        "bilingualMarkdown.targetLanguage",
        "bilingualMarkdown.styleInstructions",
        "bilingualMarkdown.glossary",
        "bilingualMarkdown.translateCodeComments"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "bilingualMarkdown.openPreview",
        "title": "%command.openPreview%",
        "category": "%category%",
        "icon": "$(globe)"
      },
      {
        "command": "bilingualMarkdown.openPreviewToSide",
        "title": "%command.openPreviewToSide%",
        "category": "%category%",
        "icon": "$(globe)"
      },
      {
        "command": "bilingualMarkdown.retranslate",
        "title": "%command.retranslate%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "bilingualMarkdown.setApiKey",
        "title": "%command.setApiKey%",
        "category": "%category%",
        "icon": "$(key)"
      },
      {
        "command": "bilingualMarkdown.clearApiKey",
        "title": "%command.clearApiKey%",
        "category": "%category%"
      },
      {
        "command": "bilingualMarkdown.switchProvider",
        "title": "%command.switchProvider%",
        "category": "%category%"
      },
      {
        "command": "bilingualMarkdown.clearCache",
        "title": "%command.clearCache%",
        "category": "%category%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bilingualMarkdown.openPreviewToSide",
          "when": "editorLangId == markdown && !notebookEditorFocused",
          "group": "navigation"
        },
        {
          "command": "bilingualMarkdown.retranslate",
          "when": "activeWebviewPanelId == 'bilingualMarkdown.preview'",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "bilingualMarkdown.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "bilingualMarkdown.openPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "bilingualMarkdown.openPreviewToSide",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "bilingualMarkdown.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai"
          ],
          "enumDescriptions": [
            "%config.provider.anthropic%",
            "%config.provider.openai%"
          ],
          "default": "anthropic",
          "markdownDescription": "%config.provider%",
          "scope": "machine",
          "order": 0
        },
        "bilingualMarkdown.targetLanguage": {
          "type": "string",
          "default": "Japanese",
          "markdownDescription": "%config.targetLanguage%",
          "order": 1
        },
        "bilingualMarkdown.anthropic.model": {
          "type": "string",
          "default": "claude-haiku-5-5",
          "markdownDescription": "%config.anthropic.model%",
          "scope": "machine",
          "order": 2
        },
        "bilingualMarkdown.openai.model": {
          "type": "string",
          "default": "gpt-6-luna",
          "markdownDescription": "%config.openai.model%",
          "scope": "machine",
          "order": 3
        },
        "bilingualMarkdown.openai.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.openai.baseUrl%",
          "scope": "machine",
          "order": 4
        },
        "bilingualMarkdown.reasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "default"
          ],
          "enumDescriptions": [
            "%config.reasoningEffort.none%",
            "%config.reasoningEffort.low%",
            "%config.reasoningEffort.medium%",
            "%config.reasoningEffort.high%",
            "%config.reasoningEffort.default%"
          ],
          "default": "none",
          "markdownDescription": "%config.reasoningEffort%",
          "scope": "machine",
          "order": 5
        },
        "bilingualMarkdown.styleInstructions": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "%config.styleInstructions%",
          "order": 6
        },
        "bilingualMarkdown.glossary": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "%config.glossary%",
          "order": 7
        },
        "bilingualMarkdown.translateCodeComments": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.translateCodeComments%",
          "order": 8
        },
        "bilingualMarkdown.maxConcurrentRequests": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "markdownDescription": "%config.maxConcurrentRequests%",
          "scope": "machine",
          "order": 9
        },
        "bilingualMarkdown.batchCharacterLimit": {
          "type": "integer",
          "default": 4000,
          "minimum": 500,
          "maximum": 20000,
          "markdownDescription": "%config.batchCharacterLimit%",
          "scope": "machine",
          "order": 10
        },
        "bilingualMarkdown.syncScroll": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.syncScroll%",
          "order": 11
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "package": "vsce package --no-dependencies --skip-license",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "openai": "^7.53.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
