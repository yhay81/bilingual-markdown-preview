{
  "name": "markdown-translation-preview",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "private": true,
  "publisher": "yhay81",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#173A8C",
    "theme": "dark"
  },
  "homepage": "https://github.com/yhay81/markdown-translation-preview#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yhay81/markdown-translation-preview.git"
  },
  "bugs": {
    "url": "https://github.com/yhay81/markdown-translation-preview/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Visualization",
    "AI"
  ],
  "keywords": [
    "markdown",
    "preview",
    "translation",
    "translate",
    "translator",
    "bilingual",
    "side-by-side",
    "japanese",
    "localization",
    "i18n",
    "llm",
    "ai",
    "claude",
    "anthropic",
    "openai",
    "gpt",
    "openrouter",
    "gemini",
    "deepseek",
    "mistral",
    "grok",
    "copilot",
    "ollama",
    "byok",
    "katex",
    "mermaid"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onWebviewPanel:markdownTranslation.preview"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces%",
      "restrictedConfigurations": [
        "markdownTranslation.targetLanguage",
        "markdownTranslation.styleInstructions",
        "markdownTranslation.glossary",
        "markdownTranslation.translateCodeComments"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "markdownTranslation.openPreview",
        "title": "%command.openPreview%",
        "category": "%category%",
        "icon": "$(globe)"
      },
      {
        "command": "markdownTranslation.openPreviewToSide",
        "title": "%command.openPreviewToSide%",
        "category": "%category%",
        "icon": "$(globe)"
      },
      {
        "command": "markdownTranslation.retranslate",
        "title": "%command.retranslate%",
        "category": "%category%",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownTranslation.exportTranslation",
        "title": "%command.exportTranslation%",
        "category": "%category%",
        "icon": "$(save-as)"
      },
      {
        "command": "markdownTranslation.setApiKey",
        "title": "%command.setApiKey%",
        "category": "%category%",
        "icon": "$(key)"
      },
      {
        "command": "markdownTranslation.clearApiKey",
        "title": "%command.clearApiKey%",
        "category": "%category%"
      },
      {
        "command": "markdownTranslation.switchProvider",
        "title": "%command.switchProvider%",
        "category": "%category%"
      },
      {
        "command": "markdownTranslation.clearCache",
        "title": "%command.clearCache%",
        "category": "%category%"
      },
      {
        "command": "markdownTranslation.chooseModel",
        "title": "%command.chooseModel%",
        "category": "%category%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownTranslation.openPreviewToSide",
          "when": "editorLangId == markdown && !notebookEditorFocused",
          "group": "navigation"
        },
        {
          "command": "markdownTranslation.retranslate",
          "when": "activeWebviewPanelId == 'markdownTranslation.preview'",
          "group": "navigation"
        },
        {
          "command": "markdownTranslation.exportTranslation",
          "when": "activeWebviewPanelId == 'markdownTranslation.preview'",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownTranslation.openPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownTranslation.openPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownTranslation.openPreviewToSide",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownTranslation.exportTranslation",
          "when": "editorLangId == markdown || activeWebviewPanelId == 'markdownTranslation.preview'"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "markdownTranslation.provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai",
            "openrouter",
            "gemini",
            "deepseek",
            "mistral",
            "xai",
            "vscode"
          ],
          "enumDescriptions": [
            "%config.provider.anthropic%",
            "%config.provider.openai%",
            "%config.provider.openrouter%",
            "%config.provider.gemini%",
            "%config.provider.deepseek%",
            "%config.provider.mistral%",
            "%config.provider.xai%",
            "%config.provider.vscode%"
          ],
          "default": "anthropic",
          "markdownDescription": "%config.provider%",
          "scope": "machine",
          "order": 0
        },
        "markdownTranslation.targetLanguage": {
          "type": "string",
          "default": "Japanese",
          "markdownDescription": "%config.targetLanguage%",
          "order": 1
        },
        "markdownTranslation.anthropic.model": {
          "type": "string",
          "default": "claude-haiku-5-5",
          "markdownDescription": "%config.anthropic.model%",
          "scope": "machine",
          "order": 2
        },
        "markdownTranslation.openai.model": {
          "type": "string",
          "default": "gpt-6-luna",
          "markdownDescription": "%config.openai.model%",
          "scope": "machine",
          "order": 3
        },
        "markdownTranslation.openai.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.openai.baseUrl%",
          "scope": "machine",
          "order": 4
        },
        "markdownTranslation.openrouter.model": {
          "type": "string",
          "default": "google/gemini-3.8-flash",
          "markdownDescription": "%config.openrouter.model%",
          "scope": "machine",
          "order": 5
        },
        "markdownTranslation.gemini.model": {
          "type": "string",
          "default": "gemini-3.8-flash",
          "markdownDescription": "%config.gemini.model%",
          "scope": "machine",
          "order": 6
        },
        "markdownTranslation.deepseek.model": {
          "type": "string",
          "default": "deepseek-flash",
          "markdownDescription": "%config.deepseek.model%",
          "scope": "machine",
          "order": 7
        },
        "markdownTranslation.mistral.model": {
          "type": "string",
          "default": "mistral-small-2603",
          "markdownDescription": "%config.mistral.model%",
          "scope": "machine",
          "order": 8
        },
        "markdownTranslation.xai.model": {
          "type": "string",
          "default": "grok-4.3",
          "markdownDescription": "%config.xai.model%",
          "scope": "machine",
          "order": 9
        },
        "markdownTranslation.vscode.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.vscode.model%",
          "scope": "machine",
          "order": 10
        },
        "markdownTranslation.reasoningEffort": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "default"
          ],
          "enumDescriptions": [
            "%config.reasoningEffort.none%",
            "%config.reasoningEffort.low%",
            "%config.reasoningEffort.medium%",
            "%config.reasoningEffort.high%",
            "%config.reasoningEffort.default%"
          ],
          "default": "none",
          "markdownDescription": "%config.reasoningEffort%",
          "scope": "machine",
          "order": 11
        },
        "markdownTranslation.styleInstructions": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "%config.styleInstructions%",
          "order": 12
        },
        "markdownTranslation.glossary": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "%config.glossary%",
          "order": 13
        },
        "markdownTranslation.translateCodeComments": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.translateCodeComments%",
          "order": 14
        },
        "markdownTranslation.maxConcurrentRequests": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 8,
          "markdownDescription": "%config.maxConcurrentRequests%",
          "scope": "machine",
          "order": 15
        },
        "markdownTranslation.batchCharacterLimit": {
          "type": "integer",
          "default": 4000,
          "minimum": 500,
          "maximum": 20000,
          "markdownDescription": "%config.batchCharacterLimit%",
          "scope": "machine",
          "order": 16
        },
        "markdownTranslation.tokenLimit": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.tokenLimit%",
          "scope": "machine",
          "order": 17
        },
        "markdownTranslation.syncScroll": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.syncScroll%",
          "order": 18
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "test:e2e": "node esbuild.mjs --e2e && vscode-test",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "openai": "^7.53.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.101.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
